# Kopieren nach .env und Werte anpassen. .env selbst ist gitignored.

UID=1000
GID=1000

POSTGRES_USER=dmigrate
POSTGRES_PASSWORD=change-me
POSTGRES_DB=dmigrate
PG_PORT=5433

# Volle Connect-URL fuer die "local_pg"-Connection in .d-migrate.yaml
# (credentialRef: env:D_MIGRATE_LOCAL_PG_URL). Bei Aenderung von
# POSTGRES_USER/PASSWORD/DB oben manuell nachziehen. Host statt Servicename,
# weil d-migrate-mcp per network_mode: host laeuft (siehe .d-migrate.yaml).
D_MIGRATE_LOCAL_PG_URL=postgresql://dmigrate:change-me@127.0.0.1:5433/dmigrate

# MSSQL_SA_PASSWORD muss die SQL-Server-Komplexitaetsregel erfuellen
# (mind. 8 Zeichen, 3 von 4 Kategorien: Gross-/Kleinbuchstaben, Ziffer,
# Sonderzeichen) und darf keine URL-reservierten Zeichen enthalten
# (@ : / ? # %), sonst muss D_MIGRATE_LOCAL_MSSQL_URL sie percent-encoden.
MSSQL_SA_PASSWORD=Change-Me-123!
MSSQL_PORT=1433

# Volle Connect-URL fuer die "local_mssql"-Connection in .d-migrate.yaml
# (credentialRef: env:D_MIGRATE_LOCAL_MSSQL_URL). Zeigt auf die Datenbank
# "dmigrate" (nicht "master" -- die legt der mssql-init-Service beim ersten
# Start an). encrypt=false, weil der lokale Container kein gueltiges
# TLS-Zertifikat hat. Bei Aenderung von MSSQL_SA_PASSWORD oben manuell
# nachziehen.
D_MIGRATE_LOCAL_MSSQL_URL=mssql://sa:Change-Me-123!@127.0.0.1:1433/dmigrate?encrypt=false

MYSQL_ROOT_PASSWORD=change-me
MYSQL_PORT=3306

# Volle Connect-URL fuer die "local_mysql"-Connection in .d-migrate.yaml
# (credentialRef: env:D_MIGRATE_LOCAL_MYSQL_URL). MYSQL_DATABASE=dmigrate
# (siehe docker-compose.yml) legt die Datenbank beim ersten Start automatisch
# an. Bei Aenderung von MYSQL_ROOT_PASSWORD oben manuell nachziehen.
D_MIGRATE_LOCAL_MYSQL_URL=mysql://root:change-me@127.0.0.1:3306/dmigrate

# Volle Connect-URL fuer die "local_sqlite"-Connection in .d-migrate.yaml
# (credentialRef: env:D_MIGRATE_LOCAL_SQLITE_URL). Datei liegt unter
# ./sqlite-data (nach /work/sqlite-data gemountet), wird bei Bedarf angelegt
# (mode=rwc). spatialite=true laedt das im Runtime-Image enthaltene
# mod_spatialite. Kein Secret, aber die MCP-Mapping-Form verlangt trotzdem
# eine credentialRef statt einer Bare-URL.
D_MIGRATE_LOCAL_SQLITE_URL=sqlite:///work/sqlite-data/local.db?spatialite=true

# ORACLE_PASSWORD wird beim ersten Start des "oracle"-Services auch als
# APP_USER_PASSWORD fuer den App-User "dmigrate" (FREEPDB1) benutzt — muss
# also zur D_MIGRATE_LOCAL_ORACLE_URL unten synchron bleiben. Keine
# URL-reservierten Zeichen, kein Prozent-Encoding noetig halten.
ORACLE_PASSWORD=Change-Me-123!
ORACLE_PORT=1521

# Volle Connect-URL fuer die "local_oracle"-Connection in .d-migrate.yaml
# (credentialRef: env:D_MIGRATE_LOCAL_ORACLE_URL). Ziel ist die PDB
# FREEPDB1 des gvenzl/oracle-free-Service; der User "dmigrate" wird beim
# ersten Containerstart angelegt (inkl. Tablespace-Quota) — der erste Boot
# braucht deshalb einige Minuten. Bei Aenderung von ORACLE_PASSWORD oben
# manuell nachziehen.
D_MIGRATE_LOCAL_ORACLE_URL=oracle://dmigrate:Change-Me-123!@127.0.0.1:1521/FREEPDB1
